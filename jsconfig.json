{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "checkJs": true,
    "allowJs": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["**/*.js", "**/*.ts", "node_modules/@zeppos/device-types/dist/index.d.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "site",
    "site/**/*",
    "dist",
    "build",
    "eslint.config.js",
    "prettier.config.js"
  ]
}
