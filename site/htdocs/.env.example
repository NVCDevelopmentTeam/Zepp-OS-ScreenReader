# GitHub OAuth Configuration (used by /admin/oauth to sign in to the Sveltia CMS)
#
# Local development: copy this file to `.env` (or `.dev.vars`) and fill in the values.
# Production (Cloudflare Workers): never commit the values. Set them in the dashboard under
# Workers & Pages > zsr > Settings > Variables and Secrets, or with:
#   npx wrangler secret put OAUTH_GITHUB_CLIENT_ID
#   npx wrangler secret put OAUTH_GITHUB_CLIENT_SECRET
OAUTH_GITHUB_CLIENT_ID=your_github_client_id_here
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret_here
