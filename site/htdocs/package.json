		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@unocss/eslint-plugin": "^66.12.0",
		"@unocss/inspector": "^66.12.0",
		"@unocss/preset-icons": "^66.12.0",
		"@unocss/preset-typography": "^66.12.0",
		"@unocss/preset-wind": "^66.12.0",
