{
	"name": "zsr",
	"description": "Zepp OS screen reader official website",
	"private": true,
	"version": "1.0.6",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@mdsvex/plugin-anchors": "^0.1.1",
		"@mdsvex/plugin-page-data": "^0.1.2",
		"@mdsvex/plugin-toc": "^0.1.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@unocss/eslint-plugin": "^66.13.0",
		"@unocss/inspector": "^66.13.0",
		"@unocss/preset-icons": "^66.13.0",
		"@unocss/preset-typography": "^66.13.0",
		"@unocss/preset-wind": "^66.13.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.12.0",
		"unocss": "^66.13.0",
		"vite": "^8.4.0"
	},
	"dependencies": {
		"@sveltia/cms": "^0.273.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
